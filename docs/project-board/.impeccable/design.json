  "narrative": {
    "northStar": "Warm Desk Ledger",
    "overview": "这是 Warm Desk Ledger 在项目管理中的局部扩展：暖纸背景、墨色层级、语义分类色与细栏线维持原品牌，柔和纹理和拖动重量感帮助辨认与移动工作项。四列工作台的形式来自已批准原型，未重新选择 FORM，也没有随机 seed。\n\n本文件只约束项目看板及其工作项弹窗；全局品牌仍以根 DESIGN.md 为准。记录依据为实际组件、样式与最终桌面、手机、暗色和纹理选择器截图；功能与验证详情见 README.md。",
    "keyCharacteristics": [
      "语义色随明暗主题切换",
      "Inter 为看板信息主字体，复用小圆角",
      "纹理可选、拖动有重量、减少动态效果可用"
    ],
    "rules": [
      {
        "name": "Shared Palette",
        "body": "纹理、状态与进度复用现有语义色，不建立项目专属色表。",
        "section": "colors"
      },
      {
        "name": "Lift While Carried",
        "body": "卡片静止时保持轻阴影，仅拖动浮层使用明显抬升阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保留任务、里程碑与习惯的视觉与行为区别；习惯独立打卡。",
      "Do 保留手机拖柄、完成和打卡的至少 44×44px 命中区。",
      "Do 复用主题变量、双语文案和减少动态效果分支。"
    ],
    "donts": [
      "Don’t 将局部四列构图、纹理或拖动倾角推广为全站规则。",
      "Don’t 把颜色或纹理当作事项类型、完成状态的唯一提示。",
      "Don’t 把截图中的示例项目、日期或设计试验工具栏写入产品规范。"
    ]
  }
